rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ['codewithpom@gmail.com'];
    }
    function validStudent() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('^rkmv[0-9]+@gmail\\.com$');
    }
    function regno() { return request.auth.token.email.split('@')[0].split('rkmv')[1]; }
    function rosterExists(r) {
      return exists(/databases/$(database)/documents/roster/$(r));
    }
    // meta/config {approval: 'auto'|'admin'}; a missing doc means auto
    function approvalRequired() {
      return exists(/databases/$(database)/documents/meta/config)
        && get(/databases/$(database)/documents/meta/config).data.approval == 'admin';
    }
    function approved() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    match /roster/{r} {
      allow read: if admin() || (validStudent() && r == regno());
      allow write: if admin(); // roster is imported from the admin dashboard, never by students
    }
    match /users/{uid} {
      allow create: if validStudent() && uid == request.auth.uid
        && rosterExists(regno())
        && request.resource.data.keys().hasOnly(['email', 'regno', 'pid', 'status', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.regno == regno()
        && request.resource.data.pid == get(/databases/$(database)/documents/roster/$(regno())).data.pid
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == (approvalRequired() ? 'pending' : 'approved'); // auto: the roster is the gate; an admin can still block
      allow read: if admin() || (signedIn() && uid == request.auth.uid);
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['approved', 'blocked'];
      allow delete: if false;
    }
    match /votes/{voteId} {
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      function voteOk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['qid', 'qtype', 'uid', 'regno', 'answer', 'ts'])
          && d.keys().hasAll(['qid', 'qtype', 'uid', 'regno', 'answer', 'ts'])
          && d.uid == request.auth.uid
          && ((d.qtype == 'face' && d.qid.matches('^f[A-Za-z0-9:_.-]{1,40}$'))
            || (d.qtype == 'cluster' && d.qid.matches('^c[0-9]{1,6}$'))
            || (d.qtype == 'scene' && d.qid.matches('^s[A-Za-z0-9_.-]{1,40}$')))
          && approved()
          && voteId == d.qid + '__' + request.auth.uid
          && d.regno == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.regno
          && d.answer is string
          && d.answer.matches('^[A-Za-z0-9_.:-]{1,64}$')
          && d.ts == request.time;
      }
      allow create: if signedIn() && voteOk();
      allow update: if signedIn() && voteOk()
        && request.time > resource.data.ts + duration.value(10, 's');
      allow delete: if signedIn() && approved() && resource.data.uid == request.auth.uid;
    }
    match /people_extra/{pid} {
      function shape() {
        let d = request.resource.data;
        return d.keys().hasOnly(['reg_no', 'name', 'batch', 'addedBy', 'ts'])
          && d.keys().hasAll(['reg_no', 'name', 'batch', 'addedBy', 'ts'])
          && pid.matches('^S[0-9]{4,6}$')
          && d.reg_no is string && d.reg_no.matches('^[0-9]{4,6}$')
          && pid == 'S' + d.reg_no
          && d.name is string && d.name.size() <= 60
          && d.batch is string && d.batch.matches('^MB[0-9]{2}$')
          && d.addedBy is string && d.ts is timestamp;
      }
      allow read: if admin() || approved();
      allow create: if approved() && shape()
        && rosterExists(request.resource.data.reg_no)
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.ts == request.time;
      allow update: if admin() && shape()
        && request.resource.data.reg_no == resource.data.reg_no
        && request.resource.data.addedBy == resource.data.addedBy
        && request.resource.data.ts == resource.data.ts;
      allow delete: if admin();
    }
    match /meta/progress {
      allow read: if admin() || approved();
      allow write: if admin();
    }
    match /meta/config {
      allow read: if admin() || validStudent();
      allow write: if admin()
        && request.resource.data.keys().hasOnly(['approval'])
        && request.resource.data.approval in ['auto', 'admin'];
    }
    match /overrides/{qid} {
      allow read: if admin();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['qid', 'answer', 'adminEmail', 'ts'])
        && request.resource.data.qid == qid
        && request.resource.data.answer is string
        && request.resource.data.answer.size() > 0
        && request.resource.data.answer.size() <= 64
        && request.resource.data.adminEmail == request.auth.token.email;
      allow delete: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
